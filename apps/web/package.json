{
  "name": "@opencut/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-site-content.mjs --check && node scripts/build-classic-exporter.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/check-boundaries.test.mjs scripts/scene-preview-consumption.test.mjs scripts/scene-preview-continuity.test.mjs",
    "typecheck": "tsc --noEmit",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "contracts:check": "node ../../packages/sdk-ts/scripts/generate.mjs --check",
    "verify:browser": "python3 ../../scripts/verify-web.py"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@noble/hashes": "2.4.0",
    "culori": "4.0.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/culori": "4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
